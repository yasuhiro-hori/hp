---
import CornerMarks from "@/components/astro/shared/CornerMarks.astro";
import SectionHeader from "@/components/astro/shared/SectionHeader.astro";

const items = [
    {
        jp: "棚卸しする",
        en: "inventory / triage",
        d: "溜まった脆弱性アラートを一つずつ確認し、実際のコードと照らし合わせて「本当に対応が必要なもの」を切り分けます。数百件あっても、まずは全体像をつかむところから。",
        tags: ["アラート整理", "影響判定", "優先順位づけ"],
    },
    {
        jp: "安全に直す",
        en: "fix & release",
        d: "ライブラリやフレームワークの更新、コードの修正を、動作確認とセットで行います。更新して動かなくなる、という心配ができるだけ起きないよう、段階的に進めます。",
        tags: ["ライブラリ更新", "fw更新", "動作確認", "リリース"],
    },
    {
        jp: "守り続ける",
        en: "keep it updated",
        d: "脆弱性は毎週のように公開されます。継続的な確認と更新を月額の枠で回し、対応状況はエンジニアでない方にも分かる言葉でご報告します。",
        tags: ["継続監視", "月次レポート", "保守運用"],
    },
];
---

<section id="services" class="bp-section">
    <div class="bp-section-inner">
        <SectionHeader no="02" en="SERVICES" jp="提供価値" />

        <div class="svc-grid">
            {
                items.map((x) => (
                    <article class="svc-card">
                        <CornerMarks />
                        <h3>{x.jp}</h3>
                        <div class="svc-en">{x.en}</div>
                        <p>{x.d}</p>
                        <div class="svc-tags">
                            {x.tags.map((t) => <span class="bp-tag">{t}</span>)}
                        </div>
                    </article>
                ))
            }
        </div>
    </div>
</section>

<style>
    .svc-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
    @media (max-width: 900px) {
        .svc-grid { grid-template-columns: 1fr; }
    }

    .svc-card {
        background: var(--bp-paper);
        border: 1.5px solid var(--bp-ink);
        padding: 28px;
        position: relative;
    }

    .svc-meta {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono),serif;
        font-size: 11px;
        letter-spacing: 0.14em;
        color: var(--bp-blue);
        margin-bottom: 28px;
        font-weight: 600;
    }
    .svc-meta .muted {
        opacity: 0.5;
    }

    .svc-card h3 {
        font-family: var(--font-sans),serif;
        font-size: 30px;
        font-weight: 900;
        color: var(--bp-ink);
        margin: 0 0 8px;
        letter-spacing: -0.015em;
    }

    .svc-en {
        font-family: var(--font-mono),serif;
        font-size: 12px;
        color: var(--bp-muted);
        letter-spacing: 0.08em;
        margin-bottom: 20px;
    }

    .svc-card p {
        font-family: var(--font-sans),serif;
        font-size: 14px;
        line-height: 1.85;
        color: var(--bp-ink-soft);
        margin: 0 0 24px;
    }

    .svc-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }
</style>
