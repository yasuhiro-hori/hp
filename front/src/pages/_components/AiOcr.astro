---
import SectionHeader from "@/components/astro/shared/SectionHeader.astro";

const cases = [
    {
        id: 1,
        tag: "SECURITY / UPDATE",
        t: "脆弱性対応",
        d: "溜まった脆弱性アラートの棚卸しから、ライブラリ・フレームワークの更新、継続的な監視まで。他社が開発したシステムにも対応します。",
        stack: "npm · go modules · docker · aws",
        href: "/services/vulnerability/",
    },
    {
        id: 2,
        tag: "SECURITY / AUDIT",
        t: "バイブコーディング セキュリティ診断",
        d: "社内の担当者がAIで作ったツールを対象に、認証・権限・データの扱いを第三者の目で確認し、課題を緊急度別にまとめます。",
        stack: "supabase · firebase · next.js",
        href: "/services#vibe-coding-audit",
    },
    {
        id: 3,
        tag: "MAINTENANCE / LAB",
        t: "保守運用・引き継ぎ",
        d: "保守が止まったシステムの引き継ぎや、日々の小さな改修を、月0.3人月から続けられるラボ型契約でお支えします。",
        stack: "go · next.js · aws",
        href: "/services/lab-development/",
    },
];
---

<section id="works" class="bp-section">
    <div class="bp-section-inner">
        <SectionHeader no="04" en="WORKS" jp="サービス" />

        <div class="works-grid">
            {
                cases.map((c) => (
                    <a href={c.href} class="work-card">
                        <div class="work-body">
                            <div class="work-meta">
                                <span>● {c.tag}</span>
                            </div>
                            <h3>{c.t}</h3>
                            <p>{c.d}</p>
                            <div class="work-stack">stack: {c.stack}</div>
                        </div>
                    </a>
                ))
            }
        </div>
    </div>
</section>

<style>
    .works-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
    }
    @media (max-width: 900px) {
        .works-grid { grid-template-columns: 1fr; }
    }

    .work-card {
        background: var(--bp-paper-2);
        border: 1.5px solid var(--bp-ink);
        display: flex;
        flex-direction: column;
        text-decoration: none;
        color: inherit;
        transition: transform 0.18s ease;
    }
    .work-card:hover {
        transform: translateY(-2px);
        color: inherit;
    }
    .work-card:hover h3 {
        color: var(--bp-blue);
    }

    .work-preview {
        height: 160px;
        background-color: var(--bp-paper);
        border-bottom: 1px solid var(--bp-ink);
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .work-preview span {
        font-family: var(--font-mono),serif;
        font-size: 12px;
        color: var(--bp-ink);
        letter-spacing: 0.12em;
        opacity: 0.6;
    }

    .work-body { padding: 22px; }

    .work-meta {
        display: flex;
        justify-content: space-between;
        font-family: var(--font-mono),serif;
        font-size: 10px;
        letter-spacing: 0.14em;
        color: var(--bp-blue);
        margin-bottom: 16px;
    }
    .work-meta .muted { opacity: 0.5; }

    .work-card h3 {
        font-family: var(--font-sans),serif;
        font-size: 22px;
        font-weight: 900;
        color: var(--bp-ink);
        margin: 0 0 10px;
        letter-spacing: -0.015em;
        transition: color 0.15s ease;
    }
    .work-card p {
        font-family: var(--font-sans),serif;
        font-size: 13px;
        line-height: 1.8;
        color: var(--bp-ink-soft);
        margin: 0 0 20px;
    }
    .work-stack {
        padding-top: 14px;
        border-top: 1px dashed var(--bp-border-dash);
        font-family: var(--font-mono),serif;
        font-size: 11px;
        color: var(--bp-muted);
        letter-spacing: 0.06em;
    }
</style>
