---
import SectionHeader from "@/components/astro/shared/SectionHeader.astro";

const faqs = [
    {
        q: "社内にエンジニアがいませんが、相談しても大丈夫ですか？",
        a: "はい、むしろそういった会社さまからのご相談が多いです。脆弱性の判断や修正は私たちが担いますので、技術的なことが分からなくても問題ありません。対応状況は、エンジニアでない方にも分かる言葉でご報告します。",
    },
    {
        q: "脆弱性アラートが大量に溜まっています。どこから手を付ければいいですか？",
        a: "まずは私たちに見せていただくところからで大丈夫です。アラートのすべてが実際に危険なわけではないため、コードを確認して本当に対応が必要なものを切り分け、優先順位をつけてご提案します。",
    },
    {
        q: "更新したらシステムが動かなくなりませんか？",
        a: "その心配があるからこそ、更新と動作確認をセットで行います。テストの仕組みがないシステムでは、主要な画面や機能の確認手順を作るところから始め、大きな更新は段階的に進めます。",
    },
    {
        q: "費用や期間はどのくらいかかりますか？",
        a: "システムの規模や脆弱性の件数によって変わるため、現状を確認したうえでお見積もりします。溜まったアラートをまとめて片付けるスポット対応と、月0.3人月から続けられる継続対応のどちらが合うかもあわせてご提案します。",
    },
    {
        q: "1人月に満たない小さな案件でも相談できますか？",
        a: "はい、お受けしています。月0.3人月（月6日程度）から使えるラボ型契約のほか、数日で終わる改修・調査・技術相談といったスポットのご依頼にも対応します。「フルタイムで雇うほどではないが、社内だけでは手が回らない」という規模がむしろ得意な領域です。ご依頼の内容によって、その都度お見積もりする形と、月ごとに一定量を確保する形のどちらが合うかをご提案します。",
    },
    {
        q: "既存システムの保守運用だけでもお願いできますか？",
        a: "対応できます。他社が開発したシステムや、社内の担当者が作ったツールの引き継ぎも含めてご相談ください。障害対応・小さな機能追加・ライブラリのバージョン更新・クラウド費用の見直しなどを、月ごとの契約で継続的に支えます。まずは現状のコードと構成を確認させていただき、引き継ぎに必要な作業と月々の稼働量をご提示します。",
    },
];

const faqJsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
    })),
};
---

<section id="faq" class="bp-section">
    <div class="bp-section-inner">
        <SectionHeader no="05" en="FAQ" jp="よくある質問" />

        <div class="faq-list">
            {
                faqs.map((f, i) => (
                    <details class="faq-item" open={i === 0}>
                        <summary>
                            <span class="faq-q-label">Q</span>
                            <span class="faq-q-text">{f.q}</span>
                            <span class="faq-toggle" aria-hidden="true">[+]</span>
                        </summary>
                        <div class="faq-a">
                            <span class="faq-a-label">A</span>
                            <p>{f.a}</p>
                        </div>
                    </details>
                ))
            }
        </div>

        <p class="faq-more">
            対応範囲や流れの詳細は<a href="/services/vulnerability/">脆弱性対応のページ</a
            >もご覧ください。
        </p>
    </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<style>
    .faq-list {
        max-width: 960px;
        margin: 0 auto;
        border-top: 1.5px solid var(--bp-ink);
    }

    .faq-item {
        border-bottom: 1.5px solid var(--bp-ink);
    }
    .faq-item summary {
        display: grid;
        grid-template-columns: 70px 1fr 32px;
        gap: 20px;
        padding: 22px 8px;
        cursor: pointer;
        list-style: none;
        align-items: center;
        transition: background 0.15s ease;
    }
    .faq-item summary::-webkit-details-marker { display: none; }
    .faq-item summary:hover { background: rgba(10, 29, 58, 0.03); }

    .faq-q-label {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--bp-blue);
        letter-spacing: 0.14em;
        font-weight: 700;
    }
    .faq-q-text {
        font-family: var(--font-sans);
        font-size: 17px;
        font-weight: 700;
        color: var(--bp-ink);
        letter-spacing: -0.005em;
    }
    .faq-toggle {
        font-family: var(--font-mono);
        font-size: 14px;
        color: var(--bp-blue);
        text-align: right;
        transition: transform 0.2s ease;
    }
    .faq-item[open] .faq-toggle {
        transform: rotate(45deg);
    }

    .faq-a {
        display: grid;
        grid-template-columns: 70px 1fr;
        gap: 20px;
        padding: 0 8px 24px;
        border-top: 1px dashed var(--bp-border-dash);
        padding-top: 18px;
    }
    .faq-a-label {
        font-family: var(--font-mono);
        font-size: 12px;
        color: var(--bp-accent);
        letter-spacing: 0.14em;
        font-weight: 700;
    }
    .faq-a p {
        font-family: var(--font-sans);
        font-size: 14px;
        line-height: 1.85;
        color: var(--bp-ink-soft);
        margin: 0;
    }

    .faq-more {
        max-width: 960px;
        margin: 24px auto 0;
        font-family: var(--font-sans);
        font-size: 13px;
        color: var(--bp-muted);
        text-align: right;
    }
    .faq-more a {
        color: var(--bp-blue);
        text-decoration: none;
    }
    .faq-more a:hover {
        text-decoration: underline;
    }

    @media (max-width: 700px) {
        .faq-item summary {
            grid-template-columns: 56px 1fr 24px;
            gap: 12px;
            padding: 18px 4px;
        }
        .faq-q-text { font-size: 15px; }
        .faq-a {
            grid-template-columns: 56px 1fr;
            gap: 12px;
            padding: 14px 4px 18px;
        }
    }
</style>
