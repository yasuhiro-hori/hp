---
import Layout from "../../layouts/Layout.astro";
import Navbar from "../../components/react/Navbar";
import ProductsSection from "./_components/Products.astro";
import BackendTemplates from "./_components/BackendTemplates";
import SectionHeader from "@/components/astro/shared/SectionHeader.astro";
import Contact from "../_components/Contact.astro";
import Footer from "../../layouts/Footer.astro";
import "../../styles/globals.css";
---

<Layout
    title="AI OCR・AIベクトル検索・業務システム開発 | 株式会社テクシズ"
    description="請求書・注文書・手書き書類をAI OCRで自動読み取り。AIベクトル検索、業務システム開発まで、AIを実務で使えるかたちに落とし込むテクシズのソリューション一覧です。"
>
    <Navbar client:load />
    <main>
        <ProductsSection />

        <section id="backend-templates" class="bp-section">
            <div class="bp-section-inner">
                <SectionHeader no="05" en="BACKEND TEMPLATES" jp="基盤テンプレート" />
                <BackendTemplates client:load />
            </div>
        </section>

        <Contact />
    </main>
    <Footer />
</Layout>
