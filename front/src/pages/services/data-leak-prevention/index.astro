                    <table class="cmp-table">
                        <thead>
                            <tr>
                                <th scope="col"></th>
                                <th scope="col">VPNだけの場合</th>
                                <th scope="col" class="highlight">開発側の対策（テクシズ）</th>
                                <th scope="col">組織側の対策（責任部署）</th>
                            </tr>
                        </thead>
