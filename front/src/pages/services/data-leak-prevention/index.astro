                                        <td>{row.org}</td>
                                    </tr>
                                ))
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

        <section class="bp-section">
            <div class="bp-section-inner">
                <SectionHeader no="03" en="SYSTEM" jp="開発側で実装する対策" />
                <p class="sec-sub">
                    「防ぐ」「被害を小さくする」「早く気づく・追える」の3段構えで実装します。<span class="key-mark">★</span>
                    は特に効果が大きく、優先して入れることをおすすめする対策です。
                </p>
                <div class="measure-groups">
                    {
